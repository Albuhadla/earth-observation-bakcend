SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=sqlite:///razaza.db
FLASK_ENV=development
PORT=5050
ALLOWED_ORIGINS=*

TOKEN_EXPIRY_DAYS=30

# Google Earth Engine — leave blank to run in simulation mode
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=gee_key.json
GEE_PROJECT=

# Stripe — leave blank to run subscribe endpoint in demo mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Performance / infrastructure (all optional — safe to leave blank) ──

# How long a finished reading stays cached before being recomputed.
# Identical region+dates+index requests are served instantly from cache
# during this window instead of re-running Earth Engine.
CACHE_TTL_HOURS=24

# Error monitoring — get a free DSN at sentry.io. Leave blank to disable.
SENTRY_DSN=

# Rate limiting backend. Default (blank) uses in-memory limits, which is
# fine for a single backend instance. If you ever run more than one
# instance behind a load balancer, point this at a shared Redis instead
# so limits are enforced across all of them:
#   RATELIMIT_STORAGE_URI=redis://default:password@host:port
RATELIMIT_STORAGE_URI=

# AI-generated report descriptions and synthesis (Pro/Enterprise only).
# Get a key at console.anthropic.com — leave blank to disable the
# feature gracefully (returns a clear "not configured" error instead
# of breaking anything else).
ANTHROPIC_API_KEY=
